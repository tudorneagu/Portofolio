# Clé de l'assistant. Sans elle, le chat ne répond qu'avec les réponses préparées.
# En production elle vient des secrets GitHub (voir .github/workflows/main.yml).
ANTHROPIC_API_KEY=

# Configuration PostHog (valeurs publiques côté client)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
